    "evaluation_variants": ["raw_probabilities", "calibrated_probabilities_if_approved"],
    "teacher_student_metrics": [
      "student_mIoU", "delta_mIoU_vs_hard_label_student",
      "performance_by_teacher_confidence", "boundary_error_and_calibration"
    ]
  },
